# ==========================
# Keybindings
# ==========================

# Resize current split (macOS Option key)
# keybind = alt+h=resize_split:left,25
# keybind = alt+l=resize_split:right,25

# Resize current split (Ctrl+Cmd+[ / ])
keybind = ctrl+cmd+left_bracket=resize_split:left,25
keybind = ctrl+cmd+right_bracket=resize_split:right,25
foreground = #FEFEFE