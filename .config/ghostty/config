window-decoration = none
macos-non-native-fullscreen = true
window-padding-x = 0
window-padding-y = 0,0
window-padding-balance = true
window-padding-color = background
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14
adjust-cell-height = 0
font-thicken = false
selection-foreground = #FEFEFE
selection-background = #1b1b1b
theme = "Vesper"
cursor-text = #101010
background = #101010
background-opacity = 1
keybind = ctrl+cmd+left_bracket=resize_split:left,25
keybind = ctrl+cmd+right_bracket=resize_split:right,25
foreground = #FEFEFE
