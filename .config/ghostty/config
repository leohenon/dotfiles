
# ==========================
# Appearance
# ==========================
window-decoration = none
macos-non-native-fullscreen = true
window-padding-x = 0
window-padding-y = 0,0
window-padding-balance = true
window-padding-color = background
font-family = "JetBrainsMono Nerd Font Mono"
# font-family-bold = "JetBrainsMono Nerd Font"
# font-family-italic = "JetBrainsMono Nerd Font"
# font-family-bold-italic = "JetBrainsMono Nerd Font"
font-size = 14
adjust-cell-height = 0
font-thicken = false
# font-thicken-strength = 180

# background-opacity = 0.95

# Default selection colors (overridden by theme-switch.sh)
selection-foreground = #FEFEFE
selection-background = #1b1b1b
# ==========================
# Theme
# ==========================

# theme = "Catppuccin Mocha"
 # theme = "Catppuccin Macchiato"
# theme = "Catppuccin Frappe"
theme = "Vesper"
background = #101010
background-opacity = 1
