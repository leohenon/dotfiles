{
  "lastChangelogVersion": "0.74.0",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": true,
  "theme": "vesper",
  "packages": [
    {
      "source": "npm:pi-web-access",
      "extensions": [
        "+index.ts"
      ],
      "skills": [
        "+skills/librarian/SKILL.md"
      ]
    },
    {
      "source": "npm:@tintinweb/pi-subagents",
      "extensions": [
        "+src/index.ts"
      ]
    },
    {
      "source": "npm:pi-fff",
      "extensions": [
        "+index.ts"
      ]
    },
    {
      "source": "git:github.com/v2nic/pi-caveman",
      "extensions": [
        "-extensions/caveman/index.ts"
      ],
      "skills": [
        "-skills/caveman/SKILL.md"
      ]
    },
    {
      "source": "git:github.com/forrestchang/andrej-karpathy-skills",
      "skills": [
        "+skills/karpathy-guidelines/SKILL.md"
      ]
    },
    {
      "source": "npm:pi-anthropic-oauth",
      "extensions": [
        "+src/index.ts"
      ]
    },
    {
      "source": "git:github.com/offline-ant/pi-tmux",
      "extensions": [
        "-extensions/fork-split.ts",
        "-extensions/supervisor.ts",
        "-extensions/tmux.ts"
      ]
    },
    {
      "source": "git:github.com/leohenon/pi-stash",
      "extensions": [
        "+src/index.ts"
      ]
    },
    {
      "source": "npm:pi-snake",
      "extensions": [
        "+extensions/pi-snake.ts"
      ]
    },
    {
      "source": "npm:pi-session-summary",
      "extensions": [
        "-index.ts"
      ]
    },
    {
      "source": "git:github.com/leohenon/pi-tool-display",
      "extensions": [
        "+index.ts"
      ]
    },
    {
      "source": "npm:pi-skill-palette",
      "extensions": [
        "+index.ts"
      ]
    },
    "npm:pi-vim",
    "npm:pi-interactive-shell",
    "npm:pi-codex-image-gen",
    {
      "source": "npm:pi-lens",
      "skills": [
        "+skills/pi-lens-ast-grep/SKILL.md",
        "+skills/pi-lens-lsp-navigation/SKILL.md",
        "+skills/pi-lens-write-ast-grep-rule/SKILL.md",
        "+skills/pi-lens-write-tree-sitter-rule/SKILL.md"
      ],
      "extensions": [
        "+dist/index.js"
      ]
    },
    "npm:pi-diff",
    "../../dev/pi-copy-session-path"
  ],
  "themes": [
    "+themes/vesper.json"
  ],
  "extensions": [
    "+extensions/pi-timestamps-status-only.ts"
  ],
  "retry": {
    "enabled": true
  },
  "steeringMode": "all",
  "followUpMode": "one-at-a-time",
  "compaction": {
    "enabled": true
  },
  "prompts": [
    "-prompts/analyze-issue.md",
    "-prompts/commit-msg.md",
    "-prompts/pr-review.md"
  ],
  "quietStartup": true,
  "collapseChangelog": false
}
