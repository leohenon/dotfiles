[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = leohenon
	email = 77656081+lhenon999@users.noreply.github.com
[init]
	defaultBranch = main
[diff]
	tool = nvimdiff
	colorMoved = default
[difftool]
	prompt = false
[merge]
	conflictstyle = zdiff3
